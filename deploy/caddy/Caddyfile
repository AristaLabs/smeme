# Production TLS terminator for Core self-host (H-07).
#
# Replace {$SMEME_PUBLIC_HOST} via Caddy env, or edit this file to your FQDN.
# Mount certificates at /etc/caddy/certs (see docker-compose.core.prod.yml).
#
# Example self-signed for lab only:
#   mkdir -p deploy/caddy/certs
#   openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
#     -keyout deploy/caddy/certs/tls.key \
#     -out deploy/caddy/certs/tls.crt \
#     -subj "/CN=localhost"
#
# Prefer publicly trusted certs (ACME / your CA) for real deployments.

{$SMEME_PUBLIC_HOST:localhost} {
	tls /etc/caddy/certs/tls.crt /etc/caddy/certs/tls.key

	encode gzip
	reverse_proxy web:8000
}
