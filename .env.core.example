# Example env for Core self-host (docker-compose.core.yml)
#
#   ./scripts/init_core_env.sh
#   docker compose --env-file .env.core -f docker-compose.core.yml pull
#   docker compose --env-file .env.core -f docker-compose.core.yml up -d --no-build --wait
#
# Core only — no Stripe, Plausible, or Business waitlist (those are SaaS overlay).
# Postgres is not published on the host; web listens on 127.0.0.1:8000 only.
# Production TLS: see docker-compose.core.prod.yml + deploy/caddy/.
# Full variable reference: docs/guides/self-host-env.md

# --- Image (operator pull path) ---
# Prefer digest pin for production. Tag is fine for local pilots.
# Prefer digest pin for production (fill after publish evidence).
SMEME_CORE_IMAGE=ghcr.io/aristalabs/smeme:v0.9.9
# SMEME_CORE_IMAGE=ghcr.io/aristalabs/smeme@sha256:<release-digest>

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
SQLALCHEMY_LOG_LEVEL=WARNING
# Comma-separated / JSON origins for browser CORS (include your BASE_URL origin)
# ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# --- Required secrets (empty = Compose refuses to start; use init_core_env.sh) ---
SECRET_KEY=
JWT_SECRET_KEY=
POSTGRES_PASSWORD=
# DATABASE_URL is built by Compose from POSTGRES_PASSWORD (do not set by hand here).
BASE_URL=http://127.0.0.1:8000

# --- AI generation wizard (FLAG-GATED; independent of MCP authoring) ---
# SOVEREIGNTY: enabling this sends briefs, research text, and draft decision-tree
# content to OpenAI. Leave false for a sovereignty-preserving appliance.
SMEME_AI_GENERATION_ENABLED=false
# OPENAI_API_KEY=sk-...
# SOVEREIGNTY: Tavily receives search queries derived from the brief (only if generation is on)
# TAVILY_API_KEY=tvly-...
# SHOW_DECISION_TREE_GENERATION_REGION_SELECTOR=true

# LangSmith / LangChain tracing is intentionally disabled at Core startup.

# --- Auth (Clerk — turnkey AS for browser login + MCP OAuth) ---
# CLERK_SECRET_KEY=sk_...
# CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SIGN_IN_URL=https://your-instance.accounts.dev/sign-in
# CLERK_SIGN_UP_URL=https://your-instance.accounts.dev/sign-up
# CLERK_SIGN_OUT_URL=https://your-instance.accounts.dev/sign-out
# CLERK_WEBHOOK_SECRET=whsec_...
# CLERK_OAUTH_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_OAUTH_DYNAMIC_REGISTRATION=false

# --- MCP ---
MCP_ENABLED=false
# MCP_HTTP_PATH=/api/v1/mcp
# MCP_AUTHORING_GRAPH_TOOLS_ENABLED=true
# SMEME_MCP_ALLOWED_OAUTH_CLIENT_IDS=
# SMEME_MCP_OAUTH_ACCESS_TOKEN_AUDIENCE=
# SMEME_MCP_TRANSPORT_RATE_LIMIT_PER_IP_PER_MINUTE=120
# SMEME_MCP_TRANSPORT_RATE_LIMIT_PER_SUB_PER_MINUTE=240
# MCP_INVOCATION_TELEMETRY_ENABLED=true
# MCP_INVOCATION_TELEMETRY_PERSIST=true

# --- First-user provision / legal audit (required for new Users) ---
# MCP_FIRST_PROVISIONING_ENABLED=false
# SMEME_MCP_FIRST_PROVISION_RATE_LIMIT_PER_IP_PER_MINUTE=10
# SMEME_MCP_FIRST_PROVISION_RATE_LIMIT_PER_SUB_PER_MINUTE=5
# SMEME_LEGAL_TERMS_URL=https://www.smeme.ai/legal/terms
# SMEME_LEGAL_PRIVACY_URL=https://www.smeme.ai/legal/privacy
# SMEME_LEGAL_TERMS_VERSION=2026-07-20
# SMEME_LEGAL_PRIVACY_VERSION=2026-07-20

# Production host for Caddy (docker-compose.core.prod.yml)
# SMEME_PUBLIC_HOST=app.example.com

# Not for Core: STRIPE_*, PLAUSIBLE_*, SENDGRID_* / waitlist mail, MCP_COST_* (SaaS COGS)
