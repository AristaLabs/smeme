# Example env for Core self-host (docker-compose.core.yml)
#   cp .env.core.example .env.core
#   docker compose --env-file .env.core -f docker-compose.core.yml up --build
#
# Core only — no Stripe, Plausible, or Business waitlist (those are SaaS overlay).

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# Comma-separated origins for browser CORS (include your BASE_URL origin)
# ALLOWED_ORIGINS=["http://localhost:8000"]

# --- Required secrets ---
SECRET_KEY=replace-with-long-random-string
JWT_SECRET_KEY=replace-with-long-random-string
BASE_URL=http://localhost:8000

# --- AI generation wizard (FLAG-GATED Core) ---
# SOVEREIGNTY: enabling this sends briefs, research text, and draft decision-tree
# content to OpenAI. Leave false for a sovereignty-preserving appliance.
# Off by default in Dockerfile.core so the image boots without OpenAI.
SMEME_AI_GENERATION_ENABLED=false
# OPENAI_API_KEY=sk-...
# SOVEREIGNTY: Tavily receives search queries derived from the brief (only if generation is on)
# TAVILY_API_KEY=tvly-...
# Show Tavily country control on the generation brief form (default true)
# SHOW_DECISION_TREE_GENERATION_REGION_SELECTOR=true

# LangSmith / LangChain tracing is intentionally disabled at Core/SaaS startup
# (disable_langsmith_tracing). SOVEREIGNTY: if ever re-enabled, full LangGraph I/O
# (prompts/state) would leave the host. Keys here have no effect today.

# --- Auth (Clerk profile; generic OIDC later) ---
# CLERK_SECRET_KEY=sk_...
# CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SIGN_IN_URL=https://your-instance.accounts.dev/sign-in
# CLERK_SIGN_UP_URL=https://your-instance.accounts.dev/sign-up
# CLERK_SIGN_OUT_URL=https://your-instance.accounts.dev/sign-out
# CLERK_WEBHOOK_SECRET=whsec_...
# CLERK_OAUTH_ISSUER=https://your-instance.clerk.accounts.dev
# Self-host with DCR off + static Cowork client: set true only if Dashboard DCR is on
# CLERK_OAUTH_DYNAMIC_REGISTRATION=false

# --- MCP (FLAG-GATED Core; usually on for appliances) ---
MCP_ENABLED=false
# MCP_HTTP_PATH=/api/v1/mcp
# Chat authoring tools (design/validate/create/get/update draft); default on
# MCP_AUTHORING_GRAPH_TOOLS_ENABLED=true
# Set false to hide smeme_authoring_* tools while keeping MCP evaluation
# Static OAuth client allowlist when DCR is off (comma-separated). Blank = do not enforce.
# SMEME_MCP_ALLOWED_OAUTH_CLIENT_IDS=
# Optional JWT aud binding (leave unset if Clerk has no stable MCP audience)
# SMEME_MCP_OAUTH_ACCESS_TOKEN_AUDIENCE=
# Transport rate limits (0 disables that dimension)
# SMEME_MCP_TRANSPORT_RATE_LIMIT_PER_IP_PER_MINUTE=120
# SMEME_MCP_TRANSPORT_RATE_LIMIT_PER_SUB_PER_MINUTE=240
# Invocation telemetry (quota/ops metering); safe to leave on.
# Core: hosted Free/Pro **enforcement is off** by default (SaaS overlay registers it).
# There is no self-host env switch that reuses SaaS Free/Pro tier caps.
# MCP_INVOCATION_TELEMETRY_ENABLED=true
# MCP_INVOCATION_TELEMETRY_PERSIST=true

# Not for Core: STRIPE_*, PLAUSIBLE_*, SENDGRID_* / waitlist mail, MCP_COST_* (SaaS COGS)